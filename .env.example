# Microsoft Entra ID App Registration Details
# SPA Platform Configuration:
# Redirect URI: http://localhost:5173 (or production domain)
# Supported Account Types: Accounts in any organizational directory and personal Microsoft accounts (common)

VITE_ENTRA_CLIENT_ID=your_client_id_here
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Scopes: Strict AppFolder isolation (OneDrive/Apps/Keep) + Profile
VITE_GRAPH_SCOPES=Files.ReadWrite.AppFolder User.Read
